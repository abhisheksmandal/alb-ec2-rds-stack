# Copy to terraform.tfvars and fill in real values before planning/applying.

ami_id           = "ami-0xxxxxxxxxxxxxxxx" # Amazon Linux 2023 / Ubuntu AMI for ap-south-1
ssh_allowed_cidr = "203.0.113.4/32"        # your IP, /32 recommended

ec2_subnet_type    = "private" # "public" or "private"
enable_nat_gateway = true      # required if ec2_subnet_type = "private" for outbound internet

# --- Dev-sized examples; bump these for staging/prod environments ---
# az_count             = 2
# single_nat_gateway   = true
# ec2_instance_type    = "t3.micro"   # e.g. "t3.large" for prod
# ec2_instance_count   = 2
# db_instance_class    = "db.t3.micro" # e.g. "db.t3.large" for prod
# db_multi_az          = false         # true for prod
# db_backup_retention_period = 1       # 7+ for prod
# enable_ssm           = true          # reach private instances without SSH
# alb_allowed_cidrs    = ["0.0.0.0/0"]

# --- Host-based routing: frontend + backend on the same instances ---
# services = [
#   {
#     name         = "frontend"
#     port         = 3000
#     host_headers = ["app.example.com"]
#     is_default   = true
#   },
#   {
#     name         = "backend"
#     port         = 4000
#     host_headers = ["api.example.com"]
#     is_default   = false
#   }
# ]

# --- HTTPS + SNI: needed for host-based routing to actually serve TLS ---
# enable_https            = true
# certificate_arn         = "arn:aws:acm:ap-south-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" # cert for app.example.com
# additional_certificate_arns = ["arn:aws:acm:ap-south-1:123456789012:certificate/yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy"] # cert for api.example.com, if separate from the primary
# redirect_http_to_https  = true
